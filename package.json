{
  "name": "cycleiq",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Private, on-device period and symptom tracker for regular cycles, PCOS, PCOD, endometriosis and perimenopause.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itisar-345/CycleIQ.git"
  },
  "homepage": "https://github.com/itisar-345/CycleIQ#readme",
  "bugs": {
    "url": "https://github.com/itisar-345/CycleIQ/issues"
  },
  "keywords": [
    "period-tracker",
    "menstrual-cycle",
    "pcos",
    "endometriosis",
    "privacy",
    "expo",
    "react-native"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "tsx --require ./tests/support/register-fakes.cjs tests/run-tests.ts && tsx --require ./tests/support/register-fakes.cjs tests/database.test.ts",
    "backtest": "tsx tests/backtest.ts",
    "test:ui": "jest",
    "typecheck": "tsc --noEmit",
    "test:all": "npm test && npm run test:ui",
    "check": "npm run typecheck && npm run lint && npm run test:all",
    "e2e": "maestro test .maestro",
    "screenshots": "node scripts/screenshots/run.js",
    "web:demo": "node scripts/web-demo.js"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "@noble/ciphers": "^1.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.44",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.55.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "babel-preset-expo": "~54.0.10",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "gifenc": "^1.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^23.11.1",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/ui/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/ui/setup.ts"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "testTimeout": 30000
  }
}
